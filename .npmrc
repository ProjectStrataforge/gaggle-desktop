disturl="https://electronjs.org/headers"
target="42.8.0"
ms_build_id="14845705"
runtime="electron"
ignore-scripts=false
build_from_source="true"
legacy-peer-deps="true"
timeout=180000
# 114: first-party StrataForge SDKs (SMR, SovereignDB) come from the organisation's
# private GitHub Packages feed. Registry mapping only — the credential is supplied
# at build time by env (NODE_AUTH_TOKEN) through the user-level npmrc the Gaggle
# compile lane writes; never a token in this file.
@projectstrataforge:registry=https://npm.pkg.github.com
